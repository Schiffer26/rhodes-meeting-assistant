{
  "name": "rhodes-server",
  "version": "0.1.0",
  "private": true,
  "description": "RHODES API service — LAN-1 backend foundation (local-only, loopback-bound)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "migrate": "tsx src/cli/migrate.ts",
    "admin:bootstrap": "tsx src/cli/admin.ts bootstrap",
    "admin:reset": "tsx src/cli/admin.ts reset"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.5",
    "@types/node": "22.19.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
