new file mode 100644
index 0000000..d95a469
--- /dev/null
+++ b/server/test/config-production-tls.test.ts
@@ -0,0 +1,174 @@
+/**
+ * Production TLS is mandatory (LAN-3.2, Phase 1).
+ *
+ * A production deploy that loses its certificate variables must not come up on plain
+ * HTTP: that is a silent downgrade, and every later request would be unencrypted. The
+ * configuration loader therefore fails closed, before the data directory is created and
+ * before anything binds a socket, with one stable code the service host can key on.
+ *
+ * All certificate material here is the repository's disposable test fixture. Nothing in
+ * this file touches a real certificate, a real key, or any machine configuration.
+ */
+
+import assert from 'node:assert/strict';
+import { existsSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+
+import { ConfigError } from '../src/errors.js';
+import { loadConfig } from '../src/config.js';
+import { TLS_FIXTURES, removeDir, tempDataDir, tlsEnv } from './helpers.js';
+
+/** The stable code production reports for any TLS problem. */
+const TLS_REQUIRED = 'config.tls_required';
+
+function expectConfigError(fn: () => unknown, code: string): ConfigError {
+  try {
+    fn();
+  } catch (error) {
+    assert.ok(error instanceof ConfigError, `expected a ConfigError, got ${String(error)}`);
+    assert.equal(error.code, code);
+    return error;
+  }
+  throw new assert.AssertionError({ message: `expected a ConfigError with code ${code}` });
+}
+
+test('production without TLS is refused with a stable code', () => {
+  const dir = tempDataDir();
+  try {
+    const dataDir = path.join(dir, 'never-created');
+    const error = expectConfigError(
+      () => loadConfig({ NODE_ENV: 'production', RHODES_DATA_DIR: dataDir }),
+      TLS_REQUIRED,
+    );
+
+    assert.match(error.message, /RHODES_TLS_CERT_FILE/);
+    assert.match(error.message, /RHODES_TLS_KEY_FILE/);
+    assert.equal(existsSync(dataDir), false, 'nothing is created for a refused configuration');
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('production with only half a TLS pair is refused under the same code', () => {
+  const dir = tempDataDir();
+  try {
+    const onlyCert = expectConfigError(
+      () =>
+        loadConfig({
+          NODE_ENV: 'production',
+          RHODES_DATA_DIR: dir,
+          RHODES_TLS_CERT_FILE: TLS_FIXTURES.certFile,
+        }),
+      TLS_REQUIRED,
+    );
+    // The diagnosis survives: the message names the underlying, more specific code.
+    assert.match(onlyCert.message, /config\.tls_incomplete/);
+    assert.equal(onlyCert.details?.cause, 'config.tls_incomplete');
+
+    const onlyKey = expectConfigError(
+      () =>
+        loadConfig({
+          NODE_ENV: 'production',
+          RHODES_DATA_DIR: dir,
+          RHODES_TLS_KEY_FILE: TLS_FIXTURES.keyFile,
+        }),
+      TLS_REQUIRED,
+    );
+    assert.equal(onlyKey.details?.cause, 'config.tls_incomplete');
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('production with unreadable or unusable material is refused, not downgraded', () => {
+  const dir = tempDataDir();
+  try {
+    const missingFiles = expectConfigError(
+      () =>
+        loadConfig({
+          NODE_ENV: 'production',
+          RHODES_DATA_DIR: dir,
+          RHODES_TLS_CERT_FILE: path.join(dir, 'absent-cert.pem'),
+          RHODES_TLS_KEY_FILE: path.join(dir, 'absent-key.pem'),
+        }),
+      TLS_REQUIRED,
+    );
+    assert.match(missingFiles.message, /config\.tls_(cert|key)_unreadable/);
+
+    // A certificate paired with the wrong key is not usable TLS either.
+    const mismatched = expectConfigError(
+      () =>
+        loadConfig({
+          NODE_ENV: 'production',
+          RHODES_DATA_DIR: dir,
+          RHODES_TLS_CERT_FILE: TLS_FIXTURES.certFile,
+          RHODES_TLS_KEY_FILE: TLS_FIXTURES.otherKeyFile,
+        }),
+      TLS_REQUIRED,
+    );
+    assert.equal(mismatched.details?.cause, 'config.tls_pair_mismatch');
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('production with valid TLS is accepted and reports https', () => {
+  const dir = tempDataDir();
+  try {
+    const config = loadConfig({
+      NODE_ENV: 'production',
+      RHODES_DATA_DIR: dir,
+      ...tlsEnv(),
+    });
+
+    assert.equal(config.nodeEnv, 'production');
+    assert.equal(config.transport, 'https');
+    assert.ok(config.tls !== null);
+    assert.match(config.tls.certificate.fingerprint256, /^([0-9A-F]{2}:){31}[0-9A-F]{2}$/);
+    assert.equal(config.databasePath, path.join(config.dataDir, 'rhodes.db'));
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('development and test keep plain HTTP and their specific TLS messages', () => {
+  const dir = tempDataDir();
+  try {
+    for (const nodeEnv of ['development', 'test'] as const) {
+      const plain = loadConfig({ NODE_ENV: nodeEnv, RHODES_DATA_DIR: dir });
+      assert.equal(plain.transport, 'http', `${nodeEnv} may run on loopback HTTP`);
+      assert.equal(plain.tls, null);
+
+      // A half-configured pair is still refused, but with the precise reason: in
+      // development that is a typo to explain, not a policy failure.
+      expectConfigError(
+        () =>
+          loadConfig({
+            NODE_ENV: nodeEnv,
+            RHODES_DATA_DIR: dir,
+            RHODES_TLS_CERT_FILE: TLS_FIXTURES.certFile,
+          }),
+        'config.tls_incomplete',
+      );
+    }
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('a bad data directory is still reported as the data directory in production', () => {
+  // The TLS gate runs late on purpose: an operator who mistyped the data directory should
+  // hear about that, not about the certificate they never got to configure.
+  const dir = tempDataDir();
+  try {
+    const notADirectory = path.join(dir, 'not-a-directory');
+    writeFileSync(notADirectory, 'x');
+    expectConfigError(
+      () => loadConfig({ NODE_ENV: 'production', RHODES_DATA_DIR: notADirectory, ...tlsEnv() }),
+      'config.data_dir_not_a_directory',
+    );
+  } finally {
+    removeDir(dir);
+  }
+});
diff --git a/server/test/service-process.test.ts b/server/test/service-process.test.ts
new file mode 100644
index 0000000..e056ce9
--- /dev/null
+++ b/server/test/service-process.test.ts
@@ -0,0 +1,253 @@
+/**
+ * The real process, driven the way a Windows service host drives it (LAN-3.2, Phase 1).
+ *
+ * The unit tests prove the pieces; this file proves the *contract* end to end: a child
+ * process is spawned from `src/index.ts`, told to shut down over stdin, and must exit 0
+ * only after writing the final structured line. Everything is event-driven — the test
+ * waits for a specific log line, never for a fixed delay.
+ */
+
+import assert from 'node:assert/strict';
+import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+import { removeDir, tempDataDir } from './helpers.js';
+
+const serverRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+type LogLine = Record<string, unknown>;
+
+interface ServiceProcess {
+  readonly child: ChildProcessWithoutNullStreams;
+  /** Resolves with the first line (already seen or future) matching `msg`. */
+  waitForMessage(msg: string, timeoutMs?: number): Promise<LogLine>;
+  /** All lines seen so far, in order. */
+  lines(): LogLine[];
+  waitForExit(timeoutMs?: number): Promise<{ code: number | null; signal: NodeJS.Signals | null }>;
+}
+
+const DEFAULT_TIMEOUT_MS = 30_000;
+
+function startProcess(dataDir: string, extraEnv: Record<string, string> = {}): ServiceProcess {
+  const child = spawn(process.execPath, ['--import', 'tsx', 'src/index.ts'], {
+    cwd: serverRoot,
+    env: {
+      ...process.env,
+      NODE_ENV: 'test',
+      RHODES_DATA_DIR: dataDir,
+      RHODES_PORT: '0',
+      ...extraEnv,
+    },
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+
+  const seen: LogLine[] = [];
+  let exited = false;
+  let exitInfo: { code: number | null; signal: NodeJS.Signals | null } | null = null;
+
+  const messageWaiters: Array<{ msg: string; resolve: (line: LogLine) => void }> = [];
+  const exitWaiters: Array<(info: { code: number | null; signal: NodeJS.Signals | null }) => void> = [];
+
+  const handleLine = (line: string): void => {
+    const trimmed = line.trim();
+    if (!trimmed.startsWith('{')) return;
+    let entry: LogLine;
+    try {
+      entry = JSON.parse(trimmed) as LogLine;
+    } catch {
+      return;
+    }
+    seen.push(entry);
+    if (typeof entry.msg !== 'string') return;
+    for (let index = messageWaiters.length - 1; index >= 0; index -= 1) {
+      const waiter = messageWaiters[index];
+      if (waiter && waiter.msg === entry.msg) {
+        messageWaiters.splice(index, 1);
+        waiter.resolve(entry);
+      }
+    }
+  };
+
+  // The logger sends info to stdout and warn/error to stderr, so both streams are parsed:
+  // otherwise a rejection line would be invisible to the test and look like a hang.
+  const attach = (stream: NodeJS.ReadableStream): void => {
+    let buffer = '';
+    stream.setEncoding('utf8');
+    stream.on('data', (chunk: string) => {
+      buffer += chunk;
+      const parts = buffer.split('\n');
+      buffer = parts.pop() ?? '';
+      for (const part of parts) handleLine(part);
+    });
+  };
+  attach(child.stdout);
+  attach(child.stderr);
+
+  child.on('exit', (code, signal) => {
+    exited = true;
+    exitInfo = { code, signal };
+    for (const waiter of exitWaiters.splice(0)) waiter(exitInfo);
+  });
+
+  const withDeadline = <T>(what: string, promise: Promise<T>, timeoutMs: number): Promise<T> =>
+    new Promise<T>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        reject(new Error(`timed out after ${timeoutMs} ms waiting for ${what}; output so far:\n${JSON.stringify(seen)}`));
+      }, timeoutMs);
+      timer.unref();
+      promise.then(
+        (value) => {
+          clearTimeout(timer);
+          resolve(value);
+        },
+        (error: unknown) => {
+          clearTimeout(timer);
+          reject(error);
+        },
+      );
+    });
+
+  return {
+    child,
+    lines: () => seen.slice(),
+    waitForMessage(msg, timeoutMs = DEFAULT_TIMEOUT_MS) {
+      const already = seen.find((line) => line.msg === msg);
+      if (already) return Promise.resolve(already);
+      const promise = new Promise<LogLine>((resolve) => {
+        messageWaiters.push({ msg, resolve });
+      });
+      return withDeadline(`the ${msg} line`, promise, timeoutMs);
+    },
+    waitForExit(timeoutMs = DEFAULT_TIMEOUT_MS) {
+      if (exited && exitInfo) return Promise.resolve(exitInfo);
+      const promise = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {
+        exitWaiters.push(resolve);
+      });
+      return withDeadline('the process to exit', promise, timeoutMs);
+    },
+  };
+}
+
+async function stopChild(child: ChildProcessWithoutNullStreams): Promise<void> {
+  if (child.exitCode !== null || child.signalCode !== null) return;
+  child.kill('SIGKILL');
+  await new Promise<void>((resolve) => child.once('exit', () => resolve()));
+}
+
+test('the service host protocol: ready, then one command, then a clean exit 0', async () => {
+  const dir = tempDataDir();
+  const service = startProcess(dir, { RHODES_SERVICE_MODE: '1' });
+  try {
+    const ready = await service.waitForMessage('service.ready');
+    assert.equal(ready.serviceMode, true);
+    assert.equal(typeof ready.port, 'number');
+    assert.equal(typeof ready.url, 'string');
+
+    // Only now is the channel listening — the host may rely on that ordering.
+    service.child.stdin.write('{"cmd":"shutdown"}\n');
+
+    const exit = await service.waitForExit();
+    assert.equal(exit.signal, null, 'the process exits on its own, it is not killed');
+    assert.equal(exit.code, 0);
+
+    const final = service.lines().filter((line) => line.msg === 'service.shutdown_complete');
+    assert.equal(final.length, 1, 'exactly one final line');
+    assert.deepEqual(
+      {
+        reason: final[0]?.reason,
+        listenerClosed: final[0]?.listenerClosed,
+        checkpointed: final[0]?.checkpointed,
+        databaseClosed: final[0]?.databaseClosed,
+        ok: final[0]?.ok,
+        exitCode: final[0]?.exitCode,
+      },
+      {
+        reason: 'stdin',
+        listenerClosed: true,
+        checkpointed: true,
+        databaseClosed: true,
+        ok: true,
+        exitCode: 0,
+      },
+    );
+
+    // The final line is the last thing the process writes.
+    const messages = service.lines().map((line) => line.msg);
+    assert.equal(messages[messages.length - 1], 'service.shutdown_complete');
+  } finally {
+    await stopChild(service.child);
+    removeDir(dir);
+  }
+});
+
+test('a malformed command is refused and the process keeps serving', async () => {
+  const dir = tempDataDir();
+  const service = startProcess(dir, { RHODES_SERVICE_MODE: '1' });
+  try {
+    await service.waitForMessage('service.ready');
+
+    service.child.stdin.write('shutdown please\n');
+    const rejected = await service.waitForMessage('service.stdin_rejected');
+    assert.equal(rejected.reason, 'malformed');
+    assert.equal(service.child.exitCode, null, 'a bad line must not stop the service');
+
+    service.child.stdin.write('{"cmd":"shutdown"}\n');
+    const exit = await service.waitForExit();
+    assert.equal(exit.code, 0);
+  } finally {
+    await stopChild(service.child);
+    removeDir(dir);
+  }
+});
+
+test('a control channel that disappears shuts the service down instead of orphaning it', async () => {
+  const dir = tempDataDir();
+  const service = startProcess(dir, { RHODES_SERVICE_MODE: '1' });
+  try {
+    await service.waitForMessage('service.ready');
+
+    service.child.stdin.end();
+    const exit = await service.waitForExit();
+    assert.equal(exit.code, 0);
+
+    const final = service.lines().find((line) => line.msg === 'service.shutdown_complete');
+    assert.equal(final?.reason, 'stdin-eof');
+    assert.equal(final?.ok, true);
+  } finally {
+    await stopChild(service.child);
+    removeDir(dir);
+  }
+});
+
+test('without service mode a terminal is not a shutdown button, and SIGTERM still works', async () => {
+  const dir = tempDataDir();
+  const service = startProcess(dir);
+  try {
+    const ready = await service.waitForMessage('service.ready');
+    assert.equal(ready.serviceMode, false);
+
+    // The same bytes that stop a service-mode process do nothing here.
+    service.child.stdin.write('{"cmd":"shutdown"}\n');
+    // Synchronise on an unrelated, later line instead of sleeping: the ready line is
+    // already behind us, so ask for a second one — it will never come, which is the point.
+    await new Promise((resolve) => setImmediate(resolve));
+    assert.equal(service.child.exitCode, null, 'the command is ignored without the flag');
+    assert.equal(
+      service.lines().some((line) => line.msg === 'service.control_received'),
+      false,
+    );
+
+    service.child.kill('SIGTERM');
+    const exit = await service.waitForExit();
+    assert.equal(exit.code, 0, 'a signal shutdown is the ordinary, clean path');
+
+    const final = service.lines().find((line) => line.msg === 'service.shutdown_complete');
+    assert.equal(final?.reason, 'SIGTERM');
+    assert.equal(final?.ok, true);
+  } finally {
+    await stopChild(service.child);
+    removeDir(dir);
+  }
+});
diff --git a/server/test/logging-sink.test.ts b/server/test/logging-sink.test.ts
new file mode 100644
index 0000000..20be2bc
--- /dev/null
+++ b/server/test/logging-sink.test.ts
@@ -0,0 +1,127 @@
+/**
+ * Log capture without touching the process streams (QA correction).
+ *
+ * `captureLogs` used to monkey-patch `process.stdout.write`. When the test runner executes
+ * a file in a child process it reads that child's TAP report from stdout, so the patch also
+ * swallowed the runner's own `ok N - …` lines: passing tests disappeared from the report
+ * and the tally came out short. The logger now exposes an injectable sink, and these tests
+ * pin both halves of that contract — capture works, and the streams are left alone.
+ */
+
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+import { currentLogSink, installLogSink, logger, setLogLevel } from '../src/logger.js';
+import { captureLogs } from './helpers.js';
+
+const serverRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+test('captureLogs leaves the process streams untouched', async () => {
+  const stdoutWrite = process.stdout.write;
+  const stderrWrite = process.stderr.write;
+
+  const logs = await captureLogs(() => {
+    logger.info('sink.probe', { value: 1 });
+    logger.warn('sink.probe_warning');
+  });
+
+  assert.equal(process.stdout.write, stdoutWrite, 'stdout.write must not be replaced');
+  assert.equal(process.stderr.write, stderrWrite, 'stderr.write must not be replaced');
+
+  const messages = logs
+    .trim()
+    .split('\n')
+    .map((line) => (JSON.parse(line) as { msg: string }).msg);
+  assert.deepEqual(messages, ['sink.probe', 'sink.probe_warning']);
+  assert.match(logs, /"value":1/);
+});
+
+test('the previous sink is restored, and captures nest', async () => {
+  const outer: string[] = [];
+
+  const restoreOuter = installLogSink((_level, line) => outer.push(line));
+  try {
+    logger.info('outer.before');
+    const inner = await captureLogs(() => {
+      logger.info('inner.only');
+    });
+    logger.info('outer.after');
+
+    assert.deepEqual(
+      outer.map((line) => (JSON.parse(line) as { msg: string }).msg),
+      ['outer.before', 'outer.after'],
+      'the nested capture must not leak into the outer sink',
+    );
+    assert.match(inner, /"msg":"inner.only"/);
+    assert.ok(!inner.includes('outer.after'), 'the inner capture must not see later lines');
+  } finally {
+    restoreOuter();
+  }
+
+  // Restoring twice is harmless, and the default sink is back afterwards.
+  restoreOuter();
+  assert.equal(typeof currentLogSink(), 'function');
+});
+
+test('nothing is captured when no sink is installed, and the level filter still applies', async () => {
+  // With the default sink in place the line goes to the streams; nothing is buffered.
+  logger.info('this line is written normally');
+
+  setLogLevel('warn');
+  try {
+    const atWarn = await captureLogs(() => {
+      logger.debug('filtered.debug');
+      logger.info('filtered.info');
+      logger.warn('kept.warn');
+    });
+    assert.equal(atWarn.trim().split('\n').length, 1);
+    assert.match(atWarn, /"msg":"kept\.warn"/);
+  } finally {
+    setLogLevel('info');
+  }
+});
+
+/** Run the probe fixture and resolve with its two streams kept apart. */
+function runLogProbe(): Promise<{ stdout: string; stderr: string; code: number | null }> {
+  const child = spawn(process.execPath, ['--import', 'tsx', path.join('test', 'fixtures', 'log-probe.ts')], {
+    cwd: serverRoot,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+
+  let stdout = '';
+  let stderr = '';
+  child.stdout.setEncoding('utf8');
+  child.stderr.setEncoding('utf8');
+  child.stdout.on('data', (chunk: string) => {
+    stdout += chunk;
+  });
+  child.stderr.on('data', (chunk: string) => {
+    stderr += chunk;
+  });
+
+  return new Promise((resolve, reject) => {
+    child.on('error', reject);
+    child.on('exit', (code) => resolve({ stdout, stderr, code }));
+  });
+}
+
+test('the default sink keeps info on stdout and warn/error on stderr', async () => {
+  const { stdout, stderr, code } = await runLogProbe();
+  assert.equal(code, 0);
+
+  const outMessages = stdout
+    .trim()
+    .split('\n')
+    .map((line) => (JSON.parse(line) as { msg: string }).msg);
+  const errMessages = stderr
+    .trim()
+    .split('\n')
+    .map((line) => (JSON.parse(line) as { msg: string }).msg);
+
+  assert.deepEqual(outMessages, ['probe.info']);
+  assert.deepEqual(errMessages, ['probe.warn', 'probe.error']);
+  assert.ok(!stdout.includes('probe.debug'), 'debug is below the default threshold');
+});
diff --git a/server/test/startup-cleanup.test.ts b/server/test/startup-cleanup.test.ts
new file mode 100644
index 0000000..edf79f6
--- /dev/null
+++ b/server/test/startup-cleanup.test.ts
@@ -0,0 +1,152 @@
+/**
+ * Failed startup must not leave anything behind (source-review finding 3).
+ *
+ * A startup that dies after the database is open used to leak the handle, and after the
+ * listener is bound it could leak the socket as well — a failed start that keeps port 4317
+ * or the WAL lock is worse than a failed start, because the next attempt fails for a
+ * different, misleading reason. These tests break each startup step in turn and assert
+ * that the cleanup runs, in the right order, before the original error is rethrown.
+ */
+
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import type { StartedServer } from '../src/server.js';
+import { startRuntime } from '../src/startup.js';
+import {
+  captureLogs,
+  openMigrated,
+  removeDir,
+  startTestServer,
+  tempDataDir,
+} from './helpers.js';
+
+function occurrences(logs: string, message: string): number {
+  return logs.split('\n').filter((line) => line.includes(`"msg":"${message}"`)).length;
+}
+
+/** The last `service.startup_cleanup` line, parsed. */
+function cleanupLine(logs: string): Record<string, unknown> {
+  const lines = logs
+    .trim()
+    .split('\n')
+    .filter((line) => line.includes('"msg":"service.startup_cleanup"'));
+  assert.equal(lines.length, 1, 'exactly one cleanup line');
+  return JSON.parse(lines[0] as string) as Record<string, unknown>;
+}
+
+function env(dataDir: string, overrides: Record<string, string> = {}): Record<string, string> {
+  return { NODE_ENV: 'test', RHODES_DATA_DIR: dataDir, RHODES_PORT: '0', ...overrides };
+}
+
+test('a failure inside createApp closes the database and rethrows the cause', async () => {
+  const dir = tempDataDir();
+  const cause = new Error('app exploded while wiring routes');
+  try {
+    const logs = await captureLogs(async () => {
+      await assert.rejects(
+        startRuntime({
+          env: env(dir),
+          createApp: () => {
+            throw cause;
+          },
+        }),
+        (error: unknown) => {
+          // The original error is what the operator sees, not a cleanup artefact.
+          assert.equal(error, cause);
+          return true;
+        },
+      );
+    });
+
+    const cleanup = cleanupLine(logs);
+    assert.equal(cleanup.listenerStarted, false, 'no listener existed yet');
+    assert.equal(cleanup.listenerClosed, undefined, 'nothing to close, nothing claimed');
+    assert.equal(cleanup.databaseClosed, true, 'the open connection was closed');
+    assert.equal(cleanup.reason, cause.message);
+    assert.equal(occurrences(logs, 'database.closed'), 1);
+
+    // The file is usable afterwards: migrations had already run before the failure.
+    const { db } = openMigrated(dir);
+    try {
+      assert.equal(db.handle.pragma('quick_check', { simple: true }), 'ok');
+    } finally {
+      db.close();
+    }
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('a failure after the listener started closes the listener and then the database', async () => {
+  const dir = tempDataDir();
+
+  let closeCalls = 0;
+  // `url` throws, which makes the first statement after a successful bind fail: the exact
+  // "listener is already accepting connections" case the cleanup has to survive.
+  const fakeRunning = {
+    port: 1,
+    protocol: 'http',
+    server: { listening: true },
+    get url(): string {
+      throw new Error('listener metadata unavailable');
+    },
+    close: async () => {
+      closeCalls += 1;
+      return { closed: true, alreadyClosed: false, forcedSockets: false };
+    },
+  } as unknown as StartedServer;
+
+  try {
+    const logs = await captureLogs(async () => {
+      await assert.rejects(
+        startRuntime({
+          env: env(dir),
+          startServer: async () => fakeRunning,
+        }),
+        /listener metadata unavailable/,
+      );
+    });
+
+    assert.equal(closeCalls, 1, 'the bound listener was closed exactly once');
+    const cleanup = cleanupLine(logs);
+    assert.equal(cleanup.listenerStarted, true);
+    assert.equal(cleanup.listenerClosed, true);
+    assert.equal(cleanup.databaseClosed, true);
+    assert.equal(occurrences(logs, 'database.closed'), 1);
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('a real bind failure closes the database and keeps the bind error', async () => {
+  const dir = tempDataDir();
+  const competingDir = tempDataDir();
+  const { db: competingDb } = openMigrated(competingDir);
+  const first = await startTestServer(competingDb);
+
+  try {
+    const logs = await captureLogs(async () => {
+      await assert.rejects(
+        startRuntime({ env: env(dir, { RHODES_PORT: String(first.running.port) }) }),
+        (error: unknown) => {
+          assert.equal((error as { code?: string }).code, 'http.bind_failed');
+          return true;
+        },
+      );
+    });
+
+    const cleanup = cleanupLine(logs);
+    assert.equal(cleanup.listenerStarted, false);
+    assert.equal(cleanup.databaseClosed, true);
+
+    // The port stayed with its owner: the failed attempt did not disturb it.
+    assert.equal(first.running.server.listening, true);
+    assert.equal((await fetch(`${first.baseUrl}/api/health`)).status, 200);
+  } finally {
+    await first.running.close();
+    competingDb.close();
+    removeDir(dir);
+    removeDir(competingDir);
+  }
+});
diff --git a/server/test/fixtures/crash-child.ts b/server/test/fixtures/crash-child.ts
new file mode 100644
index 0000000..8cd3af3
--- /dev/null
+++ b/server/test/fixtures/crash-child.ts
@@ -0,0 +1,33 @@
+/**
+ * Test fixture: commit, then die without any shutdown.
+ *
+ * Run by `db-close.test.ts` in a real child process. It opens the database the normal way,
+ * writes one meeting inside an explicit transaction, reports that the commit is durable,
+ * and then kills itself with SIGKILL — no `close()`, no checkpoint, no signal handler.
+ *
+ * That is the "power loss" case: the rows must still be there after a reopen, and the WAL
+ * left behind by the dead process must be recoverable by SQLite itself rather than tidied
+ * away by us. The parent test synchronises on the `committed` line, so there are no sleeps.
+ *
+ * Usage: node --import tsx test/fixtures/crash-child.ts <dataDir>
+ */
+
+import { insertMeeting, openMigrated } from '../helpers.js';
+
+const dataDir = process.argv[2];
+if (!dataDir) {
+  process.stderr.write('crash-child: a data directory is required\n');
+  process.exit(2);
+}
+
+const { db } = openMigrated(dataDir);
+
+db.handle.exec('begin');
+insertMeeting(db, { title: 'Committed before the crash' });
+db.handle.exec('commit');
+
+// Only after the commit is durable does the parent get to see this line.
+process.stdout.write('committed\n');
+
+// SIGKILL: the kernel ends us immediately. No flush, no unlink, no checkpoint.
+process.kill(process.pid, 'SIGKILL');
