diff --git a/server/src/shutdown.ts b/server/src/shutdown.ts
new file mode 100644
index 0000000..5d4b93b
--- /dev/null
+++ b/server/src/shutdown.ts
@@ -0,0 +1,111 @@
+/**
+ * RHODES API · shutdown reporting and the exit-code contract
+ *
+ * The process has exactly three ways to end, and each has one code:
+ *
+ *   0   every required shutdown operation succeeded
+ *   69  shutdown ran, but the checkpoint or the database connection did not complete
+ *   1   startup failure, or a fatal application fault
+ *
+ * "Shutdown ran" is not the same as "shutdown succeeded" — that distinction is the whole
+ * point of this module. The final line is written with a *synchronous* stdout write,
+ * because a Windows service host reads it to classify the shutdown and `process.exit()`
+ * can drop buffered pipe writes. Writing first and exiting afterwards is what makes the
+ * classification reliable.
+ */
+
+import { writeSync } from 'node:fs';
+
+import { describeError } from './errors.js';
+import { logger } from './logger.js';
+import type { Runtime, ShutdownResult } from './startup.js';
+
+export const EXIT_OK = 0;
+export const EXIT_SHUTDOWN_INCOMPLETE = 69;
+export const EXIT_FATAL = 1;
+
+export const SHUTDOWN_COMPLETE_MESSAGE = 'service.shutdown_complete';
+
+/** Writes one already-formatted line. Injected so tests never write to real stdout. */
+export type LineWriter = (line: string) => void;
+
+/**
+ * The default writer: a blocking write to fd 1.
+ *
+ * Synchronous on purpose. Every other log line may be buffered; this one may not, so it
+ * is flushed before the process is allowed to exit. A closed or broken stdout is
+ * swallowed: reporting is best-effort, exiting is not.
+ */
+export function writeStdoutSync(line: string): void {
+  try {
+    writeSync(1, line.endsWith('\n') ? line : `${line}\n`);
+  } catch {
+    // stdout is gone (host died, pipe closed). Nothing left to report to.
+  }
+}
+
+/**
+ * Combine the requested code with what shutdown actually achieved.
+ *
+ * A fatal or fault-triggered exit keeps its code: an uncaught exception must never be
+ * reported as a clean stop just because the shutdown itself went well. A requested stop
+ * (code 0) downgrades to 69 when any shutdown stage failed.
+ */
+export function exitCodeFor(requestedCode: number, ok: boolean): number {
+  if (requestedCode !== EXIT_OK) return requestedCode;
+  return ok ? EXIT_OK : EXIT_SHUTDOWN_INCOMPLETE;
+}
+
+export interface ShutdownReport {
+  result: ShutdownResult;
+  exitCode: number;
+  message: Record<string, unknown>;
+}
+
+const FAILED_RESULT: ShutdownResult = {
+  listenerClosed: false,
+  checkpointed: false,
+  databaseClosed: false,
+  ok: false,
+};
+
+/**
+ * Run the shutdown, emit the single final structured line, and return the exit code.
+ *
+ * The line contains all four facts plus the code, so a reader never has to infer one
+ * from another: `database.closed` alone says nothing about the listener or the
+ * checkpoint, and is deliberately not enough to call a shutdown clean.
+ */
+export async function performShutdown(options: {
+  runtime: Pick<Runtime, 'shutdown'>;
+  reason: string;
+  requestedCode: number;
+  write?: LineWriter;
+}): Promise<ShutdownReport> {
+  const write = options.write ?? writeStdoutSync;
+
+  let result: ShutdownResult;
+  try {
+    result = await options.runtime.shutdown(options.reason);
+  } catch (error) {
+    logger.error('service.shutdown_failed', { reason: describeError(error).message });
+    result = FAILED_RESULT;
+  }
+
+  const exitCode = exitCodeFor(options.requestedCode, result.ok);
+
+  const message = {
+    level: result.ok ? 'info' : 'error',
+    time: new Date().toISOString(),
+    msg: SHUTDOWN_COMPLETE_MESSAGE,
+    reason: options.reason,
+    listenerClosed: result.listenerClosed,
+    checkpointed: result.checkpointed,
+    databaseClosed: result.databaseClosed,
+    ok: result.ok,
+    exitCode,
+  };
+
+  write(JSON.stringify(message));
+  return { result, exitCode, message };
+}
diff --git a/server/src/serviceMode.ts b/server/src/serviceMode.ts
new file mode 100644
index 0000000..a020059
--- /dev/null
+++ b/server/src/serviceMode.ts
@@ -0,0 +1,244 @@
+/**
+ * RHODES API · service-mode control channel and process wiring
+ *
+ * Two jobs, both deliberately separated from `index.ts` so they can be tested without
+ * spawning a process:
+ *
+ *   1. `attachServiceMode` — an opt-in stdin control channel. It exists only when
+ *      `RHODES_SERVICE_MODE` is explicitly enabled, so ordinary development runs are
+ *      untouched (a developer typing into the terminal must never shut the server down).
+ *   2. `wireLifecycle` — register the process handlers, attach the control channel, and
+ *      only then announce `service.ready`.
+ *
+ * The order in `wireLifecycle` is the contract: `service.listening` (emitted by
+ * `startup.ts`) proves the listener bound; `service.ready` proves the process is fully
+ * wired — database up, migrations applied, listener bound, control channel attached and
+ * every signal/fault handler registered. A Windows service host waits for the latter.
+ *
+ * Control protocol, one JSON object per line on stdin:
+ *
+ *   {"cmd":"shutdown"}      -> graceful shutdown, exit 0 (or 69 if a stage failed)
+ *
+ * Anything else — malformed JSON, an unknown command, a line longer than 4096 bytes —
+ * is logged and ignored. Repeated commands are idempotent: the second one is recorded
+ * and dropped, never a second shutdown sequence.
+ */
+
+import type { EnvSource } from './config.js';
+import { describeError } from './errors.js';
+import { logger } from './logger.js';
+import type { Runtime } from './startup.js';
+
+/** Enables the stdin control channel. Anything else keeps it disabled. */
+export const SERVICE_MODE_ENV = 'RHODES_SERVICE_MODE';
+
+/** Longest control line accepted, in bytes. Anything larger is discarded unread. */
+export const MAX_CONTROL_LINE_BYTES = 4096;
+
+/** The only command the channel accepts. */
+export const SHUTDOWN_COMMAND = 'shutdown';
+
+export function isServiceModeEnabled(env: EnvSource = process.env): boolean {
+  const raw = (env[SERVICE_MODE_ENV] ?? '').trim().toLowerCase();
+  return raw === '1' || raw === 'true' || raw === 'yes';
+}
+
+/**
+ * The slice of a readable stream this module needs. `process.stdin` satisfies it; a
+ * `PassThrough` in a test satisfies it too.
+ */
+export interface ControlInput {
+  on(event: string, listener: (...args: any[]) => void): unknown;
+  off?(event: string, listener: (...args: any[]) => void): unknown;
+  removeListener?(event: string, listener: (...args: any[]) => void): unknown;
+  setEncoding?(encoding: BufferEncoding): unknown;
+  resume?(): unknown;
+  pause?(): unknown;
+}
+
+/** Minimal emitter surface, so lifecycle wiring can be tested on a fake emitter. */
+export interface LifecycleEmitter {
+  on(event: string, listener: (...args: any[]) => void): unknown;
+}
+
+export interface ServiceModeController {
+  readonly enabled: boolean;
+  detach(): void;
+}
+
+const DISABLED: ServiceModeController = { enabled: false, detach: () => {} };
+
+/**
+ * Attach the stdin control channel.
+ *
+ * Returns a controller whose `enabled` reflects the environment, and whose `detach`
+ * removes every listener it added (used by tests, and by a shutdown that wants the loop
+ * to drain instead of staying alive on stdin).
+ */
+export function attachServiceMode(options: {
+  stdin: ControlInput;
+  requestShutdown: (reason: string) => void;
+  env?: EnvSource;
+}): ServiceModeController {
+  if (!isServiceModeEnabled(options.env ?? process.env)) return DISABLED;
+
+  const stdin = options.stdin;
+  let buffer = '';
+  let requested = false;
+
+  const reject = (reason: string): void => {
+    logger.warn('service.stdin_rejected', { reason });
+  };
+
+  const request = (reason: string): void => {
+    if (requested) {
+      logger.warn('service.stdin_ignored', { reason: 'a shutdown was already requested' });
+      return;
+    }
+    requested = true;
+    logger.info('service.control_received', { reason });
+    options.requestShutdown(reason);
+  };
+
+  const handleLine = (line: string): void => {
+    if (line.trim().length === 0) return;
+    if (Buffer.byteLength(line, 'utf8') > MAX_CONTROL_LINE_BYTES) {
+      reject('oversized');
+      return;
+    }
+
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(line);
+    } catch {
+      reject('malformed');
+      return;
+    }
+
+    if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
+      reject('malformed');
+      return;
+    }
+
+    // Exactly one property, exactly the documented command: no room for a payload that
+    // a future version might interpret differently.
+    const record = parsed as Record<string, unknown>;
+    const keys = Object.keys(record);
+    if (keys.length !== 1 || keys[0] !== 'cmd' || record.cmd !== SHUTDOWN_COMMAND) {
+      reject('unknown_command');
+      return;
+    }
+
+    request('stdin');
+  };
+
+  const onData = (chunk: unknown): void => {
+    buffer += typeof chunk === 'string' ? chunk : String(chunk);
+
+    let newline = buffer.indexOf('\n');
+    while (newline >= 0) {
+      const line = buffer.slice(0, newline);
+      buffer = buffer.slice(newline + 1);
+      handleLine(line);
+      newline = buffer.indexOf('\n');
+    }
+
+    // A line that never ends must not grow without bound: drop it and say so.
+    if (buffer.length > MAX_CONTROL_LINE_BYTES) {
+      buffer = '';
+      reject('oversized');
+    }
+  };
+
+  const onEnd = (): void => {
+    // The host went away without asking us to stop. It is not an error in this process,
+    // but it is never silent: shut down now rather than idling as an orphan.
+    logger.warn('service.stdin_eof', { reason: 'the control channel closed unexpectedly' });
+    request('stdin-eof');
+  };
+
+  const onError = (error: unknown): void => {
+    logger.warn('service.stdin_error', { reason: describeError(error).message });
+    request('stdin-error');
+  };
+
+  stdin.setEncoding?.('utf8');
+  stdin.on('data', onData);
+  stdin.on('end', onEnd);
+  stdin.on('error', onError);
+  stdin.resume?.();
+
+  logger.info('service.mode', {
+    control: 'stdin',
+    maxLineBytes: MAX_CONTROL_LINE_BYTES,
+    command: SHUTDOWN_COMMAND,
+  });
+
+  return {
+    enabled: true,
+    detach(): void {
+      const remove = stdin.off ?? stdin.removeListener;
+      remove?.call(stdin, 'data', onData as (...args: any[]) => void);
+      remove?.call(stdin, 'end', onEnd as (...args: any[]) => void);
+      remove?.call(stdin, 'error', onError as (...args: any[]) => void);
+      stdin.pause?.();
+      buffer = '';
+    },
+  };
+}
+
+export interface WireLifecycleOptions {
+  runtime: Pick<Runtime, 'config' | 'running'>;
+  stdin: ControlInput;
+  emitter: LifecycleEmitter;
+  /** The single shutdown entry point; must itself be idempotent. */
+  stop: (reason: string, requestedCode: number) => void;
+  env?: EnvSource;
+}
+
+/**
+ * Register every process handler, attach the control channel, then announce readiness.
+ *
+ * `service.ready` is emitted last and only here: everything a host needs to be able to
+ * rely on already exists by the time the line is written.
+ */
+export function wireLifecycle(options: WireLifecycleOptions): {
+  serviceMode: boolean;
+  /**
+   * Detach the control channel. A shutdown calls this so a resumed stdin cannot keep the
+   * event loop alive after the final line has been written.
+   */
+  detach: () => void;
+} {
+  const { emitter, stop } = options;
+
+  emitter.on('SIGINT', (() => stop('SIGINT', 0)) as (...args: any[]) => void);
+  emitter.on('SIGTERM', (() => stop('SIGTERM', 0)) as (...args: any[]) => void);
+  emitter.on('uncaughtException', ((error: unknown) => {
+    const described = describeError(error);
+    logger.error('service.uncaught_exception', { name: described.name, message: described.message });
+    stop('uncaughtException', 1);
+  }) as (...args: any[]) => void);
+  emitter.on('unhandledRejection', ((reason: unknown) => {
+    logger.error('service.unhandled_rejection', { reason: describeError(reason).message });
+    stop('unhandledRejection', 1);
+  }) as (...args: any[]) => void);
+
+  const controller = attachServiceMode({
+    stdin: options.stdin,
+    requestShutdown: (reason) => stop(reason, 0),
+    ...(options.env === undefined ? {} : { env: options.env }),
+  });
+
+  logger.info('service.ready', {
+    pid: process.pid,
+    serviceMode: controller.enabled,
+    transport: options.runtime.config.transport,
+    host: options.runtime.config.host,
+    port: options.runtime.running.port,
+    url: options.runtime.running.url,
+    databasePath: options.runtime.config.databasePath,
+  });
+
+  return { serviceMode: controller.enabled, detach: () => controller.detach() };
+}
diff --git a/server/test/db-close.test.ts b/server/test/db-close.test.ts
new file mode 100644
index 0000000..b27f69a
--- /dev/null
+++ b/server/test/db-close.test.ts
@@ -0,0 +1,388 @@
+/**
+ * Database shutdown outcomes (LAN-3.2, Phase 1).
+ *
+ * `close()` used to return nothing: a busy checkpoint, a failed checkpoint and a clean
+ * one all looked identical, and `database.closed` was written whether or not the handle
+ * had actually closed. These tests pin the four facts apart — checkpoint attempted,
+ * checkpoint complete, connection closed, and the conjunction — and prove that the WAL
+ * is preserved rather than tidied away when the checkpoint does not finish.
+ *
+ * The failure paths (a checkpoint that throws, a close that throws) cannot be produced by
+ * a healthy SQLite handle, so they are exercised through `RhodesDatabase.forTesting` with
+ * a handle-like object. Everything else runs against a real, disposable database file in
+ * a temporary directory.
+ */
+
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { existsSync, statSync } from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+
+import Database from 'better-sqlite3';
+
+import { openDatabase, RhodesDatabase, type Db } from '../src/db/index.js';
+import {
+  captureLogs,
+  configFor,
+  insertMeeting,
+  migratedConfig,
+  openMigrated,
+  removeDir,
+  tempDataDir,
+} from './helpers.js';
+
+// ── a handle-like object, for the paths a healthy database will not take ─────
+
+interface FakeHandle {
+  open: boolean;
+  pragma: (sql: string) => unknown;
+  close: () => void;
+}
+
+function fake(behaviour: {
+  checkpoint?: () => unknown;
+  close?: () => void;
+  open?: boolean;
+}): FakeHandle {
+  const handle: FakeHandle = {
+    open: behaviour.open ?? true,
+    pragma: () => behaviour.checkpoint?.() ?? [{ busy: 0, log: 1, checkpointed: 1 }],
+    close: () => {
+      if (behaviour.close !== undefined) behaviour.close();
+      else handle.open = false;
+    },
+  };
+  return handle;
+}
+
+/** Count how many times a JSON log line with this message appears. */
+function occurrences(logs: string, message: string): number {
+  return logs.split('\n').filter((line) => line.includes(`"msg":"${message}"`)).length;
+}
+
+function wrap(handle: FakeHandle) {
+  return RhodesDatabase.forTesting(handle as unknown as Db);
+}
+
+test('a clean checkpoint and close report success', async () => {
+  const handle = fake({ checkpoint: () => [{ busy: 0, log: 4, checkpointed: 4 }] });
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.deepEqual(result, {
+      checkpoint: { busy: 0, log: 4, checkpointed: 4 },
+      checkpointed: true,
+      closed: true,
+      stage: 'done',
+      ok: true,
+    });
+  });
+
+  assert.equal(occurrences(logs, 'database.checkpointed'), 1);
+  assert.equal(occurrences(logs, 'database.closed'), 1);
+  assert.equal(occurrences(logs, 'database.close_incomplete'), 0);
+  assert.equal(occurrences(logs, 'database.checkpoint_incomplete'), 0);
+});
+
+test('an incomplete checkpoint still closes the connection, and says both', async () => {
+  const handle = fake({ checkpoint: () => [{ busy: 1, log: 4, checkpointed: 0 }] });
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.equal(result.checkpointed, false, 'a busy checkpoint is not a completed one');
+    assert.equal(result.closed, true, 'the connection must still be closed');
+    assert.equal(result.ok, false);
+    assert.equal(result.stage, 'checkpoint');
+    assert.deepEqual(result.checkpoint, { busy: 1, log: 4, checkpointed: 0 });
+    assert.equal(handle.open, false);
+  });
+
+  assert.equal(occurrences(logs, 'database.checkpoint_incomplete'), 1);
+  // A real close is reported even when the checkpoint was not: they are separate facts.
+  assert.equal(occurrences(logs, 'database.closed'), 1);
+  assert.equal(occurrences(logs, 'database.close_incomplete'), 1);
+});
+
+test('a checkpoint backlog is incomplete even when nothing was busy', async () => {
+  const handle = fake({ checkpoint: () => [{ busy: 0, log: 5, checkpointed: 3 }] });
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.equal(result.checkpointed, false);
+    assert.equal(result.closed, true);
+    assert.equal(result.ok, false);
+  });
+  assert.equal(occurrences(logs, 'database.checkpoint_incomplete'), 1);
+});
+
+test('a checkpoint that throws is reported, and the connection is still closed', async () => {
+  const handle = fake({
+    checkpoint: () => {
+      const error = new Error('disk I/O error') as Error & { code?: string };
+      error.code = 'SQLITE_IOERR';
+      throw error;
+    },
+  });
+
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.equal(result.checkpoint, null, 'no row was produced, so no outcome is claimed');
+    assert.equal(result.checkpointed, false);
+    assert.equal(result.closed, true, 'a failed checkpoint must not keep the handle open');
+    assert.equal(result.ok, false);
+    assert.equal(result.stage, 'checkpoint');
+    assert.equal(result.error?.code, 'SQLITE_IOERR');
+    assert.match(result.error?.message ?? '', /disk I\/O error/);
+  });
+
+  assert.equal(occurrences(logs, 'database.checkpoint_failed'), 1);
+  assert.equal(occurrences(logs, 'database.closed'), 1);
+});
+
+test('a connection that refuses to close is never reported as closed', async () => {
+  const handle = fake({
+    checkpoint: () => [{ busy: 0, log: 2, checkpointed: 2 }],
+    close: () => {
+      throw Object.assign(new Error('cannot close: statements in progress'), { code: 'SQLITE_BUSY' });
+    },
+  });
+
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.equal(result.closed, false);
+    assert.equal(result.ok, false);
+    assert.equal(result.stage, 'close');
+    assert.equal(result.error?.code, 'SQLITE_BUSY');
+  });
+
+  assert.equal(occurrences(logs, 'database.close_failed'), 1);
+  assert.equal(occurrences(logs, 'database.closed'), 0, 'a still-open handle is not "closed"');
+  assert.equal(occurrences(logs, 'database.close_incomplete'), 1);
+});
+
+test('a close that throws but leaves the handle closed is still not a success', async () => {
+  const handle = fake({
+    checkpoint: () => [{ busy: 0, log: 2, checkpointed: 2 }],
+    close: () => {
+      handle.open = false;
+      throw new Error('closed with a complaint');
+    },
+  });
+
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.equal(result.closed, true, 'the handle really is closed');
+    assert.equal(result.ok, false, 'a throwing close is not a clean close');
+    assert.equal(result.stage, 'close');
+  });
+
+  assert.equal(occurrences(logs, 'database.closed'), 1);
+  assert.equal(occurrences(logs, 'database.close_incomplete'), 1);
+});
+
+test('an already-closed connection is a no-op, not a failure', async () => {
+  const handle = fake({ open: false });
+
+  const logs = await captureLogs(() => {
+    const result = wrap(handle).close();
+    assert.deepEqual(result, {
+      checkpoint: null,
+      checkpointed: true,
+      closed: true,
+      stage: 'not_open',
+      ok: true,
+    });
+  });
+
+  assert.equal(logs.trim(), '', 'nothing happened, so nothing is logged');
+});
+
+test('repeated close calls return the first result and log exactly once', async () => {
+  const handle = fake({ checkpoint: () => [{ busy: 0, log: 3, checkpointed: 3 }] });
+  const db = wrap(handle);
+
+  const logs = await captureLogs(() => {
+    const first = db.close();
+    const second = db.close();
+    const third = db.close();
+    assert.deepEqual(second, first);
+    assert.deepEqual(third, first);
+  });
+
+  assert.equal(occurrences(logs, 'database.closed'), 1);
+  assert.equal(occurrences(logs, 'database.checkpointed'), 1);
+});
+
+// ── integration: a real database, a real WAL, a real reader ──────────────────
+
+test('integration: a reader blocks the checkpoint; the WAL survives and the data recovers', async () => {
+  const dir = tempDataDir();
+  // A short busy timeout keeps the "reader holds the WAL" case fast and deterministic:
+  // the truncating checkpoint gives up after 100 ms instead of the 5 s default.
+  const config = migratedConfig(dir, { RHODES_BUSY_TIMEOUT_MS: '100' });
+  const walPath = `${config.databasePath}-wal`;
+
+  const db = openDatabase(config);
+  insertMeeting(db, { title: 'Checkpoint under a reader' });
+
+  // A second connection holding a read transaction: deterministic, no sleeps.
+  const reader = new Database(config.databasePath, { readonly: true });
+  reader.exec('begin');
+  reader.prepare('select count(*) as n from meetings').get();
+
+  try {
+    assert.ok(existsSync(walPath), 'the write above must have produced a WAL');
+
+    const logs = await captureLogs(() => {
+      const result = db.close();
+      assert.equal(result.closed, true, 'the handle is closed even while a reader holds the WAL');
+      assert.equal(result.ok, false);
+      assert.equal(result.checkpointed, false);
+      assert.ok(result.checkpoint !== null, 'the pragma must return a row to inspect');
+      assert.equal(result.checkpoint?.busy, 1, 'a reader makes the truncating checkpoint busy');
+    });
+
+    assert.equal(occurrences(logs, 'database.checkpoint_incomplete'), 1);
+    assert.equal(occurrences(logs, 'database.closed'), 1);
+
+    // Nothing was deleted: the frames a backup needs are still on disk.
+    assert.ok(existsSync(walPath), 'an incomplete checkpoint must leave the WAL in place');
+    assert.ok(statSync(walPath).size > 0, 'the retained WAL still holds the committed frames');
+  } finally {
+    reader.exec('commit');
+    reader.close();
+  }
+
+  // A fresh connection replays the WAL and sees the committed row.
+  const reopened = openDatabase(config);
+  try {
+    const row = reopened.handle.prepare('select title from meetings').get() as { title: string };
+    assert.equal(row.title, 'Checkpoint under a reader');
+    assert.equal(
+      String(reopened.handle.pragma('quick_check', { simple: true })).toLowerCase(),
+      'ok',
+    );
+  } finally {
+    const result = reopened.close();
+    assert.equal(result.ok, true, 'with no reader left, the close completes cleanly');
+  }
+
+  // After a complete checkpoint the WAL is truncated away or emptied — never a data loss,
+  // because the frames have been folded into the main file.
+  assert.ok(
+    !existsSync(walPath) || statSync(walPath).size === 0,
+    'a completed TRUNCATE checkpoint empties the WAL',
+  );
+
+  removeDir(dir);
+});
+
+test('integration: a clean close on a real database reports every fact', async () => {
+  const dir = tempDataDir();
+  try {
+    const { db } = openMigrated(dir);
+    insertMeeting(db, { title: 'Clean close' });
+
+    const logs = await captureLogs(() => {
+      const result = db.close();
+      assert.equal(result.ok, true);
+      assert.equal(result.checkpointed, true);
+      assert.equal(result.closed, true);
+      assert.equal(result.stage, 'done');
+      assert.ok((result.checkpoint?.log ?? -1) >= 0);
+    });
+
+    assert.equal(occurrences(logs, 'database.closed'), 1);
+    assert.equal(occurrences(logs, 'database.close_incomplete'), 0);
+  } finally {
+    removeDir(dir);
+  }
+});
+
+test('integration: the database path is the configured one, unchanged', () => {
+  const dir = tempDataDir();
+  try {
+    const config = migratedConfig(dir);
+    const db = openDatabase(config);
+    try {
+      assert.equal(db.filePath, path.join(dir, 'rhodes.db'));
+      assert.equal(db.filePath, config.databasePath);
+    } finally {
+      db.close();
+    }
+  } finally {
+    removeDir(dir);
+  }
+});
+
+/**
+ * Run the crash fixture and resolve when the child has committed *and* died.
+ *
+ * Synchronisation is on the child's own `committed` line and its `exit` event — no
+ * timers, so a slow machine only makes the test slower, never flaky.
+ */
+async function runCrashChild(dataDir: string): Promise<{ signal: string | null; code: number | null }> {
+  const child = spawn(
+    process.execPath,
+    ['--import', 'tsx', path.join(import.meta.dirname, 'fixtures', 'crash-child.ts'), dataDir],
+    { cwd: path.join(import.meta.dirname, '..'), stdio: ['ignore', 'pipe', 'pipe'] },
+  );
+
+  const exited = new Promise<{ signal: string | null; code: number | null }>((resolve, reject) => {
+    let stdout = '';
+    let stderr = '';
+    let committed = false;
+
+    child.stdout.setEncoding('utf8');
+    child.stderr.setEncoding('utf8');
+    child.stdout.on('data', (chunk: string) => {
+      stdout += chunk;
+      if (!committed && stdout.includes('committed')) committed = true;
+    });
+    child.stderr.on('data', (chunk: string) => {
+      stderr += chunk;
+    });
+
+    child.on('error', reject);
+    child.on('exit', (code, signal) => {
+      if (!committed) {
+        reject(new Error(`the child died before committing (code ${code}, signal ${signal}): ${stderr}`));
+        return;
+      }
+      resolve({ code, signal });
+    });
+  });
+
+  return exited;
+}
+
+test('integration: rows committed before an abrupt death survive the reopen', async () => {
+  const dir = tempDataDir();
+  try {
+    // A schema at the current version, closed cleanly, so the child starts from a known state.
+    migratedConfig(dir);
+
+    const exit = await runCrashChild(dir);
+    assert.equal(exit.signal, 'SIGKILL', 'the fixture must die unclean, not shut down');
+
+    // The dead process left its WAL behind; we neither deleted it nor replayed it by hand.
+    assert.equal(existsSync(path.join(dir, 'rhodes.db-wal')), true, 'the WAL of the dead process is preserved');
+
+    const db = openDatabase(configFor(dir));
+    try {
+      const rows = db.handle.prepare("select title from meetings where title = 'Committed before the crash'").all() as Array<{ title: string }>;
+      assert.equal(rows.length, 1, 'the committed row is recovered from the WAL');
+
+      const check = db.handle.pragma('quick_check', { simple: true }) as string;
+      assert.equal(check, 'ok');
+
+      // And the reopened database can still be closed cleanly afterwards.
+      const result = db.close();
+      assert.equal(result.ok, true);
+      assert.equal(result.closed, true);
+    } finally {
+      // Idempotent: a no-op if the assertions above already closed it.
+      db.close();
+    }
+  } finally {
+    removeDir(dir);
+  }
+});
